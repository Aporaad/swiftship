{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ],
      "firebase/app": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase/auth": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase/firestore/lite": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase-admin": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase-admin/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase-admin/app": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "firebase-admin/auth": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "@firebase/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "@google-cloud/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase/app": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase/auth": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase/firestore/lite": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase-admin": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase-admin/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase-admin/app": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "supabase-admin/auth": [
        "./src/lib/supabase-firebase-adapter.ts"
      ],
      "@supabase/firestore": [
        "./src/lib/supabase-firebase-adapter.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": [
    "alx_web",
    "node_modules",
    "dist"
  ]
}