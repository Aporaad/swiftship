NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# استخدم دور alx_api_runtime فقط؛ لا تستخدم postgres أو service_role لاتصال التطبيق.
# لا تحفظ أسرار الإنتاج في Git. ترك DATABASE_URL فارغاً يبقي الخدمة في وضع not-ready.
DATABASE_URL=
DATABASE_SSL_MODE=require
# استخدم disable فقط مع PostgreSQL محلي؛ production يتطلب verify-full مع CA موثوق.
DATABASE_SSL_CA_PEM=
# اختبار localhost فقط عند الاتصال بحساب محلي مخول: يجعل PostgreSQL يبدأ الجلسة باسم alx_api_runtime.
DATABASE_RUNTIME_ROLE=
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
LOG_LEVEL=info
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
ARGON2_MEMORY_KIB=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
AUTH_DUMMY_PASSWORD_HASH=
JWT_ISSUER=swiftship-api
JWT_AUDIENCE=swiftship-client
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000
# تبقى مصادقة المصدر القديم مفعلة أثناء النقل التدريجي. لا تفعّل تغيير/إعادة تعيين
# كلمة المرور إلا بعد تحويل جميع العملاء؛ يلزم تركيب PasswordResetDelivery منفصل.
LEGACY_PASSWORD_AUTH_ENABLED=true
AUTH_PASSWORD_CHANGES_ENABLED=false
PASSWORD_RESET_TTL_SECONDS=900
