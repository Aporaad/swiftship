rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // Check if user email is in the root list
    function isRoot() {
      return isSignedIn() && "email" in request.auth.token && (
        request.auth.token.email == 'alsrhyarslan5@gmail.com' ||
        request.auth.token.email == 'arslan.alshamari@gmail.com' ||
        request.auth.token.email == 'engaporaad1@gmail.com' ||
        request.auth.token.email == 'admin@swiftship.system'
      );
    }

    // Direct universal access for super administrators
    match /{document=**} {
      allow read, write: if isRoot();
      allow read: if isSignedIn();
    }

    // Specific match for users to update/register themselves
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isRoot() || (isSignedIn() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin' || request.auth.uid == userId));
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /orders/{orderId}/trackingUpdates/{updateId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /couriers/{courierId} {
      allow read, write: if isSignedIn();
    }

    match /sources/{sourceId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    match /accounts/{accountId} {
      allow read, write: if isSignedIn();
    }

    match /account_transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }

    // Public tracking access for customers using search
    match /public_tracking/{trackingNumber} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Interactive session & logging collections
    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /activity_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /notifications/{notificationId} {
      allow read, write: if isSignedIn();
    }

    match /backups/{backupId} {
      allow read, write: if isSignedIn();
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if isRoot() || (isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin');
    }

    match /whatsapp_logs/{logId} {
      allow read, write: if isSignedIn();
    }

    match /shipping_companies/{companyId} {
      allow read, write: if isSignedIn();
    }

    match /salary_history/{historyId} {
      allow read, write: if isSignedIn();
    }

    match /assets/{assetId} {
      allow read, write: if isSignedIn();
    }

    match /report_templates/{templateId} {
      allow read, write: if isSignedIn();
    }
  }
}
