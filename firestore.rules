rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    
    // Check if user email is in the root list
    function isRoot() {
      return isSignedIn() && (
        request.auth.token.email == 'alsrhyarslan5@gmail.com' ||
        request.auth.token.email == 'arslan.alshamari@gmail.com' ||
        request.auth.token.email == 'admin@swiftship.system' ||
        request.auth.token.get('email', '') == 'alsrhyarslan5@gmail.com' ||
        request.auth.token.get('email', '') == 'arslan.alshamari@gmail.com' ||
        request.auth.token.get('email', '') == 'admin@swiftship.system'
      );
    }

    // Direct universal access for super administrators
    match /{document=**} {
      allow read, write: if isRoot();
      allow read: if isSignedIn();
    }

    // Specific match for users to update/register themselves
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /customers/{customerId} {
      allow read, write: if isSignedIn();
    }

    match /orders/{orderId} {
      allow read, write: if isSignedIn();
    }

    match /orders/{orderId}/trackingUpdates/{updateId} {
      allow read, write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /couriers/{courierId} {
      allow read, write: if isSignedIn();
    }

    match /sources/{sourceId} {
      allow read, write: if isSignedIn();
    }

    match /expenses/{expenseId} {
      allow read, write: if isSignedIn();
    }

    match /counters/{counterId} {
      allow read, write: if isSignedIn();
    }

    // Public tracking access for customers using search
    match /public_tracking/{trackingNumber} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
